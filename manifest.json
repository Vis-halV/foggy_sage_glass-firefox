{
  "manifest_version": 3,

  "name": "Foggy Sage Glass",
  "version": "1.0.0",

  "description": "A soft sage-green glass-inspired Firefox theme based on the Foggy Sage Glass Obsidian theme.",

  "browser_specific_settings": {
    "gecko": {
      "id": "foggy-sage-glass@example.com"
    }
  },

  "theme": {
    "colors": {
      "frame": "#aec7b5",
      "frame_inactive": "#a6c0ad",

      "toolbar": "#b8d0be",
      "toolbar_text": "#101710",

      "toolbar_field": "#ffffff",
      "toolbar_field_text": "#101710",
      "toolbar_field_border": "#8fa997",

      "toolbar_field_focus": "#ffffff",
      "toolbar_field_text_focus": "#101710",

      "tab_background_text": "#53635a",
      "tab_text": "#101710",
      "tab_selected": "#c4d8c9",

      "button_background_hover": "#9fbaaa",
      "button_background_active": "#8fa997",

      "icons": "#385842",
      "icons_attention": "#52745d",

      "popup": "#c4d8c9",
      "popup_text": "#101710",
      "popup_border": "#8fa997",
      "popup_highlight": "#9fbaaa",
      "popup_highlight_text": "#101710",

      "sidebar": "#aec7b5",
      "sidebar_text": "#101710",
      "sidebar_border": "#8fa997",
      "sidebar_highlight": "#9fbaaa",
      "sidebar_highlight_text": "#101710",

      "ntp_background": "#b8d0be",
      "ntp_text": "#101710",

      "bookmark_text": "#385842",

      "tab_line": "#52745d",
      "tab_loading": "#70997b",

      "toolbar_top_separator": "#8fa997",
      "toolbar_bottom_separator": "#8fa997",
      "toolbar_vertical_separator": "#8fa997"
    },

    "properties": {
      "color_scheme": "light",
      "content_color_scheme": "light"
    }
  }
}
